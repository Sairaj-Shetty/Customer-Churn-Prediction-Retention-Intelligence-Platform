# Local development setup — copy to .env and adjust.
# NEVER commit a real .env file. Only .env.example belongs in git.

# ---- Runtime ----
CHURN_ENVIRONMENT=local
CHURN_LOG_LEVEL=INFO

# ---- Database ----
# Local default is SQLite (zero setup). Docker Compose overrides this with
# the Postgres hostname:
#   CHURN_DATABASE__URL=postgresql+psycopg2://churn:churn@postgres:5432/churn
CHURN_DATABASE__URL=sqlite:///./predictions.db
CHURN_DATABASE__ECHO=false

# ---- MLflow ----
CHURN_MLFLOW__TRACKING_URI=sqlite:///mlflow.db
CHURN_MLFLOW__EXPERIMENT_NAME=telco-churn

# ---- API ----
CHURN_API__MODEL_DIR=artifacts/model
CHURN_API__MAX_BATCH_SIZE=1000

# ---- Frontend ----
# The dashboard talks to the API over these URLs. In Docker Compose the
# service name is resolved internally; in the browser preview it must be a
# same-origin relative path.
API_BASE_URL=http://localhost:8000

# ---- AWS (only needed for the production deployment path) ----
# Provide these via GitHub Secrets / ECS task definition secrets.
# Never fill real values into this file.
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=
ECR_REPOSITORY=churn-api
ECS_CLUSTER=churn-platform
ECS_SERVICE=churn-api-service
S3_MODEL_BUCKET=
