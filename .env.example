# Local development setup — copy to .env and adjust.
# NEVER commit a real .env file. Only .env.example belongs in git.

# ---- Runtime ----
CHURN_ENVIRONMENT=local
CHURN_LOG_LEVEL=INFO

# ---- Database ----
# Local default is SQLite (zero setup, no server required).
CHURN_DATABASE__URL=sqlite:///./predictions.db
CHURN_DATABASE__ECHO=false

# Neon PostgreSQL (free tier). Copy the *pooled* connection string from the
# Neon console; it already contains sslmode=require.
#
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#
# `DATABASE_URL` is accepted without the CHURN_ prefix because Render and Neon
# inject that name by convention. An explicit CHURN_DATABASE__URL always wins.
# NEVER put a real connection string in this file.
#
# Persistence is best-effort: predictions are returned before the write happens,
# and pending writes are lost if the process stops. See docs/07_DATABASE.md.
CHURN_DATABASE__PERSIST_PREDICTIONS=true
CHURN_DATABASE__RETRY_ATTEMPTS=1

# Connection budget for Neon's free tier (100 CU-hours/month). The compute
# suspends after ~5 minutes idle; pool_recycle must stay below that window.
CHURN_DATABASE__POOL_SIZE=2
CHURN_DATABASE__POOL_RECYCLE=300
CHURN_DATABASE__CONNECT_TIMEOUT=5

# ---- MLflow ----
CHURN_MLFLOW__TRACKING_URI=sqlite:///mlflow.db
CHURN_MLFLOW__EXPERIMENT_NAME=telco-churn

# ---- API ----
CHURN_API__MODEL_DIR=artifacts/model
CHURN_API__SERVING_MODEL_DIR=artifacts/model_calibrated
CHURN_API__MAX_BATCH_SIZE=1000

# ---- Public-deployment hardening ----
# Hard cap on a request body. max_batch_size limits the *number* of rows in a
# batch; this limits the bytes on the wire. 256 KB comfortably fits 100 rows.
CHURN_API__MAX_BODY_BYTES=262144
# Per-client request budget (token bucket, refills over 60 s).
CHURN_API__RATE_LIMIT_REQUESTS=120
CHURN_API__RATE_LIMIT_WINDOW_SECONDS=60
# SHAP is ~10x the CPU of a prediction, so it gets a tighter budget.
CHURN_API__EXPLAIN_RATE_LIMIT_REQUESTS=30

# How many reverse proxies in front of the API may be trusted to have appended
# X-Forwarded-For. 0 = ignore the header entirely (correct when the client's
# socket address is directly observable, e.g. local Docker). Render puts exactly
# one proxy in front of a web service, so production uses 1.
#
# Never raise this "to make it work": trusting an unvalidated header lets any
# client mint a new identity per request and bypass rate limiting completely.
CHURN_API__TRUSTED_PROXY_COUNT=0

# Bearer token for /metrics. Leave EMPTY to make the endpoint return 404.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit a real token — set it in the Render dashboard.
CHURN_API__METRICS_TOKEN=

# ---- Frontend ----
# Base URL of the API as seen from the *dashboard process*.
# * local dev / Docker Compose : http://localhost:8000  or  http://api:8000
# * Streamlit Community Cloud : set CHURN_API_URL in st.secrets, NOT here.
CHURN_API_URL=http://localhost:8000
